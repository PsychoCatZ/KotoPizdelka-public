{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "КотоПизделка",
  "version": "0.2.11",
  "identifier": "ru.kotification.kotopizdelka",
  "build": {
    "beforeDevCommand": "npm --prefix frontend run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm --prefix frontend run build",
    "frontendDist": "../frontend/dist",
    "windows": {
      "staticVCRuntime": true
    }
  },
  "app": {
    "windows": [{
      "label": "main",
      "create": false,
      "title": "КотоПизделка — личные разговоры",
      "width": 1180,
      "height": 800,
      "minWidth": 800,
      "minHeight": 620,
      "devtools": false
    }],
    "security": {
      "capabilities": ["main"],
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'",
      "devCsp": "default-src 'self'; connect-src ipc: http://ipc.localhost ws://127.0.0.1:1420; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["kotopizdelka"] },
      "mobile": [{ "scheme": ["kotopizdelka"], "host": "invite", "appLink": false }]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian", "English"],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
