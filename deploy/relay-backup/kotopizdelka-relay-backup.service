[Unit]
Description=Verified private backup of KotoPizdelka relay
After=systemd-tmpfiles-setup.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/kotopizdelka-relay/backup/relay-backup.py create
TimeoutStartSec=5min
TimeoutStopSec=15s
Nice=10
IOSchedulingClass=idle
CPUQuota=25%
MemoryMax=384M
TasksMax=16
LimitCORE=0
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/backups/kotopizdelka-relay
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
SystemCallArchitectures=native
