[Unit]
Description=KotoPizdelka private relay HTTPS proxy
Wants=network-online.target kotopizdelka-relay.service
After=network-online.target kotopizdelka-relay.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=kotopizdelka-proxy
Group=kotopizdelka-proxy
WorkingDirectory=/var/lib/kotopizdelka-proxy
Environment=XDG_DATA_HOME=/var/lib/kotopizdelka-proxy/data
Environment=XDG_CONFIG_HOME=/var/lib/kotopizdelka-proxy/config
ExecStart=/opt/kotopizdelka-relay/bin/caddy run --config /etc/kotopizdelka-relay/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077

StateDirectory=kotopizdelka-proxy
StateDirectoryMode=0700
NoNewPrivileges=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
SystemCallArchitectures=native

MemoryHigh=128M
MemoryMax=256M
CPUQuota=50%
TasksMax=512
LimitNOFILE=1024
LimitCORE=0

[Install]
WantedBy=multi-user.target
