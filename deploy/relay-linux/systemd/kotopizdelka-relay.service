[Unit]
Description=KotoPizdelka private message relay
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=kotopizdelka-relay
Group=kotopizdelka-relay
WorkingDirectory=/var/lib/kotopizdelka-relay
Environment=RELAY_BIND=127.0.0.1:8787
Environment=RELAY_DATABASE=/var/lib/kotopizdelka-relay/relay.sqlite
EnvironmentFile=/etc/kotopizdelka-relay/relay.env
ExecStart=/opt/kotopizdelka-relay/bin/messenger-relay
Restart=on-failure
RestartSec=5s
KillSignal=SIGINT
TimeoutStopSec=30s
UMask=0077

StateDirectory=kotopizdelka-relay
StateDirectoryMode=0700
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
SystemCallArchitectures=native

MemoryHigh=256M
MemoryMax=384M
CPUQuota=50%
TasksMax=512
LimitNOFILE=1024
LimitCORE=0

[Install]
WantedBy=multi-user.target
